---
import "@/styles/global.css";
import Toasts from "@/components/common/Toasts";

interface Props {
  title: string;
  description?: string;
  /** Hero liegt unter der Navigation: Navigation transparent über dem Bild. */
  overlayNav?: boolean;
}
const { title, description = "Unsere Hochzeit auf dem Rugenhof, Rügen, 16.–18. August 2027.", overlayNav = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const nav = [
  { href: "/", label: "Start", short: "Start" },
  { href: "/unterkunft", label: "Unterkunft", short: "Unterkunft" },
  { href: "/fahrgemeinschaft", label: "Fahrgemeinschaft", short: "Fahrten" },
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#12303A" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title === "Start" ? "Hochzeit auf dem Rugenhof" : `${title} · Hochzeit Rugenhof`}</title>
  </head>
  <body class="min-h-dvh">
    <header
      class:list={[
        "z-40 w-full",
        overlayNav ? "absolute top-0 text-white" : "sticky top-0 border-b bg-background/85 backdrop-blur",
      ]}
    >
      <nav class="container-page flex h-16 items-center gap-3 sm:gap-6" aria-label="Hauptnavigation">
        <a href="/" class="shrink-0 font-heading text-lg font-bold tracking-tight whitespace-nowrap">Rugenhof <span class="text-sanddorn">2027</span></a>
        <ul class="ml-auto flex items-center gap-1 overflow-x-auto text-sm font-semibold">
          {
            nav.slice(1).map((n) => (
              <li>
                <a
                  href={n.href}
                  aria-current={path === n.href ? "page" : undefined}
                  class:list={[
                    "inline-flex h-9 items-center rounded-full px-2.5 whitespace-nowrap transition-colors sm:px-3.5",
                    overlayNav ? "hover:bg-white/15 aria-[current=page]:bg-white/20" : "hover:bg-secondary aria-[current=page]:bg-primary aria-[current=page]:text-primary-foreground",
                  ]}
                >
                  <span class="sm:hidden">{n.short}</span><span class="hidden sm:inline">{n.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="container-page mt-20 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t py-6 text-[13px] text-muted-foreground">
      <span>Ferienanlage Rugenhof · Dreschvitz auf Rügen · 16.–18. August 2027</span>
      <a href="/brautpaar" class="underline-offset-4 hover:underline">Brautpaar</a>
    </footer>
    <Toasts client:only="react" />
  </body>
</html>
