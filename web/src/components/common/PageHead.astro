---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  image?: ImageMetadata;
  alt?: string;
}
const { eyebrow, title, intro, image, alt = "" } = Astro.props;
---

<div class="container-page grid gap-6 pt-10 pb-10 md:grid-cols-[3fr_2fr] md:items-end md:pt-14">
  <div class="grid gap-3">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="text-[clamp(34px,6vw,56px)] font-bold tracking-[-0.02em]">{title}</h1>
    <p class="max-w-[58ch] text-base text-muted-foreground md:text-[17px]">{intro}</p>
  </div>
  {
    image && (
      <Picture
        src={image}
        alt={alt}
        widths={[480, 800]}
        sizes="(min-width: 768px) 40vw, 100vw"
        formats={["avif", "webp"]}
        class="hidden aspect-[3/2] w-full rounded-3xl object-cover shadow-soft md:block"
        loading="eager"
      />
    )
  }
</div>
